  <!-- Two of the format cards autoplay. CSS can't pause a video, so the
       reduced-motion preference is honoured here instead: drop autoplay,
       pause what has already started, and leave the controls available. -->
  <script is:inline>
    (function () {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.mk-media video').forEach(function (v) {
        v.autoplay = false;
        v.loop = false;
        v.controls = true;
        v.pause();
      });
    })();
  </script>
