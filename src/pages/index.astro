---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteMenu from '../components/SiteMenu.astro';
---
<BaseLayout
  title="Rawan Aladdin — Designer"
  description="Rawan Aladdin is a designer working across brand identity, digital design, and motion — from the system through to the thing that ships."
  canonical="https://rawanaladdin.com/"
  bodyClass="home"
>
  <header class="home-header">
    <div class="icons">
      <a href="https://www.linkedin.com/in/rawan-aladdin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <img src="/mdi_linkedin.png" alt="LinkedIn" width="24" height="24" />
      </a>
      <a href="https://www.instagram.com/rawan.designs4u/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <img src="/mdi_instagram.png" alt="Instagram" width="24" height="24" />
      </a>
      <a href="mailto:hello@rawanaladdin.com" aria-label="Email">
        <img src="/ic_outline-email.png" alt="Email" width="24" height="24" />
      </a>
    </div>
    <SiteMenu current="home" />
  </header>

  <main class="home-main">
    <h1 class="home-name">Rawan<br />Aladdin</h1>

    <p class="home-line">
      Designer. I make the identity, the interface, and everything that
      carries it.
    </p>

    <article class="main-flex-row">
      <a href="/projects.html" class="main-link" data-transition>view my work &#8599;</a>
      <a href="/about.html" class="main-link" data-transition>learn about me &#8599;</a>
    </article>
  </main>

  <footer class="home-footer">
    <a class="home-featured" href="/feeds.html" data-transition>
      <span class="home-featured-label">Latest</span>
      <span class="home-featured-title">Feeds — brand identity, product UI &amp; launch</span>
      <span class="home-featured-arrow" aria-hidden="true">&#10230;</span>
    </a>
    <img src="/logo-orange.svg" alt="" height="44" id="logo-name" />
  </footer>

  <!-- The Lottie "loading" overlay used to fire on window.load — i.e. after
       the page had already finished rendering — and held for up to 2000ms.
       Removed along with lottie-web, which was only here to drive it. -->
  <script type="text/javascript" defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script type="text/javascript" defer src="/js/components/menu.js"></script>
  <script type="text/javascript" defer src="/js/components/gsap-fade.js"></script>
  <script type="text/javascript" defer src="/js/index.js"></script>
</BaseLayout>
