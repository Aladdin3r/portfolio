---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteMenu from '../components/SiteMenu.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((p) => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

const allTags = [...new Set(
  projects.flatMap(p => p.data.tags.split(' | ').map((t: string) => t.trim()))
)];
---
<BaseLayout
  title="Work — Rawan Aladdin"
  description="Selected design and development work by Rawan Aladdin: a shipped AI interview-coaching product, a safety-first routing prototype, and a cultural nonprofit website redesign."
  canonical="https://rawanaladdin.com/projects"
>
  <header>
    <div>
      <a href="/index.html" class="back-arrow" data-transition aria-label="Back to home">&#10229;</a>
      <h1 class="heading-page">My Works</h1>
    </div>
    <SiteMenu current="works" />
  </header>
  <main>
    <div class="filter-row">
      <div class="filter-pills" role="group" aria-label="Filter projects by discipline">
        <button type="button" class="pill active" data-filter="all" aria-pressed="true">All</button>
        {allTags.map((tag) => (
          <button type="button" class="pill" data-filter={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
      <a href="/playground.html" class="playground-link">&#9829; Playground &#8599;</a>
    </div>
    <p class="visually-hidden" id="filter-status" role="status" aria-live="polite"></p>
    <div class="flex-grid">
      {projects.map((project) => (
        <a
          href={project.data.url}
          class="project-card"
          data-tags={project.data.tags}
          data-transition
        >
          <article class="pc">
            <div class="pc-media">
              <img
                src={project.data.image}
                alt={project.data.imageAlt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="pc-body">
              <p class="pc-tags">
                {project.data.tags}
                {project.data.year && <span class="pc-year"> &middot; {project.data.year}</span>}
              </p>
              <h2 class="pc-title">{project.data.title}</h2>
              {project.data.summary && <p class="pc-summary">{project.data.summary}</p>}
              {(project.data.role || project.data.outcome) && (
                <dl class="pc-meta">
                  {project.data.role && (
                    <div class="pc-meta-row">
                      <dt>Role</dt>
                      <dd>{project.data.role}</dd>
                    </div>
                  )}
                  {project.data.outcome && (
                    <div class="pc-meta-row">
                      <dt>Outcome</dt>
                      <dd>{project.data.outcome}</dd>
                    </div>
                  )}
                </dl>
              )}
              <span class="pc-cta">
                Read the case study <span class="pc-arrow" aria-hidden="true">&#10230;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>

  <script type="text/javascript" defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script type="text/javascript" defer src="/js/components/menu.js"></script>
  <script type="text/javascript" defer src="/js/components/gsap-fade.js"></script>
  <script type="text/javascript" defer src="/js/index.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = Array.from(document.querySelectorAll('.pill'));
      const cards = Array.from(document.querySelectorAll('.project-card'));
      const status = document.getElementById('filter-status');
      if (!pills.length || !cards.length) return;

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            const isActive = p === pill;
            p.classList.toggle('active', isActive);
            // Was conveyed by colour alone; now exposed to assistive tech.
            p.setAttribute('aria-pressed', String(isActive));
          });

          const filter = pill.dataset.filter;
          let shown = 0;
          cards.forEach((card) => {
            const show = filter === 'all' || card.dataset.tags.includes(filter);
            card.hidden = !show;
            if (show) shown += 1;
          });

          if (status) {
            status.textContent =
              `${shown} ${shown === 1 ? 'project' : 'projects'} shown` +
              (filter === 'all' ? '' : ` for ${filter}`);
          }
        });
      });
    });
  </script>
</BaseLayout>
