---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Rawan Aladdin — For UBC"
  description="A targeted mini-portfolio: working inside an established brand system, from a printed publication through to the CMS, by Rawan Aladdin, for the UBC Communications Designer role in Development and Alumni Engagement."
  bodyClass="ub-pitch"
  canonical="https://rawanaladdin.com/ubc"
  noindex
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/ubc.css" />
  </Fragment>

  <main>

    <!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
    <section id="hero" class="ub-section" style="min-height: 100vh; justify-content: flex-end; padding-bottom: 8rem;">
      <p class="ub-hero-label">For UBC — Communications Designer, Development and Alumni Engagement — August 2026</p>
      <h1 class="ub-hero-h1">Hi UBC,<br>I'm Rawan.</h1>
      <p class="ub-hero-sub">
        I write the rules down and then I have to live inside them. On my last
        project that meant an eleven-page document handed to the person building
        the product, and afterwards every screen, email, page and printed thing
        made to match it. This role reverses the order. The rulebook already
        exists here, and it is a good one — so the work becomes finding what it
        leaves open.
      </p>
      <div class="ub-hero-links">
        <a href="mailto:hello@rawanaladdin.com" class="main-link">hello@rawanaladdin.com &#8599;</a>
        <a href="/projects.html" class="main-link">full portfolio &#8599;</a>
      </div>
    </section>

    <div class="ub-divider"></div>

    <!-- ══════════════════ THE LEDGER — object by object ══════════════════ -->
    <section id="ledger" class="ub-section">
      <p class="ub-section-label">Your posting, object by object</p>
      <h2 class="ub-h2">What you make,<br>and what I have made.</h2>
      <p class="ub-lede">
        Your posting names actual things: invitations and programs, stewardship
        reports, milestone reports, major gift proposals, promotional materials,
        web page elements for the giving site. I have not made any of those for a
        donor. Below is the closest thing I have made to each one, with a picture
        of it so the comparison can be checked.
      </p>
      <p class="ub-zoom-hint">Every image on this page opens full size — the thumbnails here are crops.</p>

      <div class="ub-ledger">

        <div class="ub-row">
          <p class="ub-row-k">Original design,<br>layout, and one<br>visual system</p>
          <p class="ub-row-v">
            <span class="ub-row-a">The Feeds brand guidelines</span>
            Eleven pages written for the engineer building the product — three
            approved lockups and four explicit don'ts, five colours with stated
            usage ratios, a five-step type scale, fifteen icons on one grammar,
            and an AA contrast floor. <strong>Then I applied it myself</strong>,
            across the interface, the digest email and the marketing site.
          </p>
          <div class="ub-thumb">
            <img src="/feeds/guidelines-07.webp" alt="Page 07 of the Feeds brand guidelines, showing the five-step type scale." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Stewardship and<br>milestone reports</p>
          <p class="ub-row-v">
            <span class="ub-row-a">Ancient Retrospect</span>
            A printed publication on the mosaics of the Hagia Sophia. A cover
            system, small-caps captioning, and full-bleed photographic spreads
            held to one grid across the whole book. Laid out in
            <strong>InDesign and taken through to print</strong>.
          </p>
          <div class="ub-thumb">
            <img src="/studio/retrospect.jpg" data-full="/playground-retrospect.webp" alt="Ancient Retrospect — the cover and an interior spread of a printed publication on the mosaics of the Hagia Sophia." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Event invitations,<br>programs and<br>printed collateral</p>
          <p class="ub-row-v">
            <span class="ub-row-a">The Feeds launch booth</span>
            Printed table runners, die-cut stickers in four colourways, and two
            reels looping on the screens behind them — every piece cut from the
            same identity in the same week, for a room of people walking past.
          </p>
          <div class="ub-thumb">
            <img src="/feeds/feeds-booth.webp" class="ub-crop-low" alt="The Feeds launch booth: printed table runners along the table edge, die-cut stickers laid out, and the product on screens behind." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Web page elements<br>for the giving site</p>
          <p class="ub-row-v">
            <span class="ub-row-a">SACABC</span>
            A cultural nonprofit's website redesigned and
            <strong>rebuilt in WordPress</strong> during a placement,
            art-directed from the patterns of the community it serves, with the
            web and social graphics produced in Figma as one system.
          </p>
          <div class="ub-thumb">
            <img src="/sacabc-mockup-1.webp" alt="The redesigned SACABC website shown on a laptop, with a large geometric pattern drawn from Southern African textile design." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Advertising and<br>promotional<br>materials</p>
          <p class="ub-row-v">
            <span class="ub-row-a">SyriaTek</span>
            An Arabic-language series published to a real audience: a bilingual
            identity, profile and cover art cut to each platform's own crop, and
            two pilots subtitled in both languages. 1,556 unique viewers in
            fifteen days, roughly 92% of them from outside the account.
          </p>
          <div class="ub-thumb">
            <img src="/syriatek/syriatek-frame-1.webp" class="ub-contain" alt="A vertical frame from a SyriaTek pilot, with the presenter on screen and bilingual Arabic and English subtitles." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Photography sourcing<br>and video production</p>
          <p class="ub-row-v">
            <span class="ub-row-a">MSA, University of Toronto — and SyriaTek</span>
            An academic year directing photo and video for a students'
            association, running a committee of volunteer shooters and assigning
            event coverage. And on SyriaTek, the other chair: I filmed the
            presenter takes and twenty-one B-roll clips in Syria myself.
          </p>
          <div class="ub-thumb">
            <img src="/syriatek/syriatek-timeline.webp" alt="The SyriaTek edit timeline, showing the B-roll clips and two caption tracks." loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="ub-row">
          <p class="ub-row-k">Concepts in draft,<br>developed with the<br>client to final</p>
          <p class="ub-row-v">
            <span class="ub-row-a">Onward</span>
            Discovery through launch on a coaching product for internationally
            educated nurses. A twelve-user usability test came back at 8/10 for
            ease of use, and <strong>what they said drove a redesign of the
            feedback flow before release</strong>.
          </p>
          <div class="ub-thumb">
            <img src="/ONWARD-main.webp" alt="The Onward interview coaching interface shown on a laptop and phone." loading="lazy" decoding="async" />
          </div>
        </div>

      </div>

      <p class="ub-note">
        Every row above is an analogue, and most of them are smaller than the
        equivalent piece of work here. What I would ask you to read the ledger
        for is the range of surfaces: a book, a booth, a CMS, a feed and a
        product, all held to one system.
      </p>
    </section>

    <div class="ub-divider"></div>

    <!-- ══════════════════ WORKING INSIDE SOMEBODY'S RULES ══════════════════ -->
    <section id="system" class="ub-section">
      <p class="ub-section-label">Working inside somebody's rules</p>
      <h2 class="ub-h2">Two documents<br>of the same kind.</h2>
      <p class="ub-lede">
        UBC publishes its identity, and I read it before writing any of this. On
        the left is what it fixes. On the right is the document I wrote for Feeds,
        which fixes the same categories of thing for a much smaller organisation.
        I have put them side by side because the useful qualification for this job
        is having been on the authoring end of one of these, and knowing from the
        inside what each rule costs the person who has to follow it.
      </p>

      <div class="ub-rules">
        <div>
          <h4>UBC's rulebook</h4>
          <ul>
            <li>Whitney Salishan and Guardian Egyptian, with Arial and Open Sans named for the places they cannot load</li>
            <li>UBC Blue <code>#002145</code>, and six secondary blues running down to <code>#97D4E9</code></li>
            <li>A web-accessible text colour published for every swatch, at WCAG 2.0 AA</li>
            <li>RGB for screen and CMYK for the printer, stated so a supplier handoff is unambiguous</li>
            <li>Unit signatures with their own construction, so a faculty stays recognisably UBC</li>
            <li>A conservative layout register for formal communications, with more room for student-facing work</li>
          </ul>
        </div>
        <div>
          <h4>The one I wrote for Feeds</h4>
          <ul>
            <li>Bricolage Grotesque variable, with the weight, width and optical-size axes written out</li>
            <li>Five colours, Ink <code>#11110F</code> through Paper <code>#EFF1EF</code>, each with a stated role</li>
            <li>An AA contrast floor, written as a rule and repeated as one of the don'ts</li>
            <li>A usage-ratio bar — paper 50%, ink 28%, sage 15%, the tints 7% — so proportion is a rule too</li>
            <li>Three approved lockups and four explicit don'ts: never stretch, recolour, rotate, or drop below AA</li>
            <li>A five-step type scale, each step named for the job it does</li>
          </ul>
        </div>
      </div>

      <div class="ub-spec">
        <div><div class="ub-spec-n">11</div><div class="ub-spec-l">Pages</div></div>
        <div><div class="ub-spec-n">5</div><div class="ub-spec-l">Type steps</div></div>
        <div><div class="ub-spec-n">15</div><div class="ub-spec-l">Icons, one grammar</div></div>
        <div><div class="ub-spec-n">AA</div><div class="ub-spec-l">Contrast floor</div></div>
      </div>

      <div class="ub-pages">
        <div class="ub-media">
          <img src="/feeds/guidelines-05.webp" alt="Feeds guidelines page 05: logo usage, with three approved lockup combinations and four don'ts." loading="lazy" decoding="async" />
        </div>
        <div class="ub-media">
          <img src="/feeds/guidelines-06.webp" alt="Feeds guidelines page 06: the five-colour palette with hex and RGB values, stated roles, and a usage-ratio bar." loading="lazy" decoding="async" />
        </div>
        <div class="ub-media">
          <img src="/feeds/guidelines-07.webp" alt="Feeds guidelines page 07: the five-step type scale and the variable font axes." loading="lazy" decoding="async" />
        </div>
        <div class="ub-media">
          <img src="/feeds/guidelines-08.webp" alt="Feeds guidelines page 08: fifteen custom icons sharing one drawing grammar." loading="lazy" decoding="async" />
        </div>
      </div>
      <p class="ub-caption">Four of the eleven pages. The client was the engineer building the product.</p>

      <div class="ub-decision">
        <p class="ub-decision-k">The decision behind it</p>
        <p>
          I wrote the document for one specific person in a hurry, so every page
          had to answer a question he would otherwise have to ask me. That is why
          the palette carries proportions and the type scale carries names. A
          rulebook fixes the typeface and the colour and the floor, and it leaves
          the photography, the pacing of a spread, the paper and the sequence wide
          open. Those are the parts that make a report worth opening twice, and
          they are what I would spend my attention on here.
        </p>
      </div>
    </section>

    <div class="ub-divider"></div>

    <!-- ═══════════════════════════════ PRINT ═══════════════════════════════ -->
    <section id="print" class="ub-section">
      <p class="ub-section-label">Print</p>
      <div class="ub-project-head">
        <h2 class="ub-project-title">Ancient Retrospect</h2>
        <span class="ub-meta">2024 · Self-directed</span>
      </div>
      <div class="ub-tags">
        <span class="ub-tag">Editorial</span>
        <span class="ub-tag">InDesign</span>
        <span class="ub-tag">Print production</span>
        <span class="ub-tag">Photography</span>
      </div>
      <p class="ub-lede">
        A publication on the mosaics of the Hagia Sophia, designed and taken
        through to print.
      </p>

      <div class="ub-media ub-media-narrow">
        <img src="/studio/retrospect.jpg" data-full="/playground-retrospect.webp" alt="Ancient Retrospect: the cover, showing the Hagia Sophia dome under letterspaced display capitals, beside an open interior spread with a full-bleed photograph of a carved capital." loading="lazy" decoding="async" />
      </div>

      <div class="ub-block">
        <p class="ub-block-n">The problem in it</p>
        <h3>The pictures want the whole page.</h3>
        <p>
          Long-form photographic editorial pulls in two directions at once. The
          images are the reason anyone picked the thing up, and they read best
          full-bleed and uninterrupted. The text has to stay comfortable for
          someone holding the book at arm's length, which wants margin and a
          measure that does not run away. Solving that once is a layout. Solving
          it the same way over a whole publication is what makes it a system.
        </p>
        <p>
          So the cover lockup, the small-caps captioning and the folios were fixed
          early and left alone, and the grid absorbed everything else. The
          photographs change scale from spread to spread; the reader's eye always
          knows where the caption will be.
        </p>
      </div>

      <div class="ub-block">
        <p class="ub-block-n">Why it is here</p>
        <h3>The closest thing I have made to a donor report.</h3>
        <p>
          A stewardship report and a photographic publication are the same
          production problem wearing different clothes: a long sequence of
          photography and text, a fixed identity, a print deadline, and one
          person reading it alone. I have made the second one. I would like the
          chance to make the first.
        </p>
      </div>
    </section>

    <div class="ub-divider"></div>

    <!-- ═══════════════════════ THE GIVING WEBSITE ═══════════════════════ -->
    <section id="web" class="ub-section">
      <p class="ub-section-label">The giving website</p>
      <div class="ub-project-head">
        <h2 class="ub-project-title">SACABC</h2>
        <span class="ub-meta">2023 · South African Cultural Association of BC</span>
      </div>
      <div class="ub-tags">
        <span class="ub-tag">WordPress</span>
        <span class="ub-tag">Art direction</span>
        <span class="ub-tag">Web &amp; social</span>
        <span class="ub-tag">Production coordination</span>
      </div>
      <p class="ub-lede">
        give.ubc.ca runs on WordPress, which is where I learned to build a site
        for an organisation whose audience already knew what it should look like.
      </p>

      <div class="ub-media ub-media-narrow">
        <img src="/sacabc-mockup-1.webp" alt="The redesigned SACABC site, its About page filled edge to edge with a bold geometric pattern in ochre, rust and black." loading="lazy" decoding="async" />
      </div>

      <div class="ub-block">
        <p class="ub-block-n">The art direction</p>
        <h3>The visual language was already theirs.</h3>
        <p>
          A cultural association's website has a particular trap in it: the easy
          version borrows a stock look and puts the culture in the photographs.
          I went the other way and pulled the site's whole visual system out of
          the community's own geometric textile patterns, so the colour, the
          shapes and the rhythm all came from something the audience recognised
          before they read a word.
        </p>
        <p>
          The rest of it was production: building the redesign in WordPress,
          producing the web and social graphics in Figma as one set, and holding the deadlines with the developers I was
          working alongside.
        </p>
      </div>

      <div class="ub-note">
        An enterprise WordPress instance is a larger instrument than the one I
        learned on, and I would expect to spend my first weeks learning how yours
        is put together. The editorial habit is the part that carries over: knowing
        what a page needs to say before deciding what it should look like.
      </div>
    </section>

    <div class="ub-divider"></div>

    <!-- ═══════════════════════════════ FOOTAGE ═══════════════════════════════ -->
    <section id="footage" class="ub-section">
      <p class="ub-section-label">Photography and video</p>
      <h2 class="ub-h2">From both<br>chairs.</h2>
      <p class="ub-lede">
        A good deal of this work arrives as footage somebody else shot, and the
        posting asks for both an understanding of video production and the
        sourcing of photography. I have done that job from either side of it.
      </p>

      <!-- The two pilots, playing. Each blockquote carries a real card as its
           contents — Instagram's script replaces it on success, and it stands
           on its own if the script is blocked. -->
      <div class="ub-ig-grid">

        <div class="ub-ig">
          <p class="ub-ig-k">Pilot one — Welcome</p>
          <blockquote
            class="instagram-media"
            data-instgrm-permalink="https://www.instagram.com/reel/DbNR4HenYQQ/?utm_source=ig_embed"
            data-instgrm-version="14"
          >
            <div class="ub-ig-fallback">
              <img src="/syriatek/syriatek-frame-1.webp" alt="A frame from the SyriaTek Welcome pilot: the presenter on camera with Arabic and English subtitles stacked beneath." loading="lazy" decoding="async" />
              <div class="ub-ig-fb-body">
                <p class="ub-ig-fb-t">SyriaTek — Welcome</p>
                <p class="ub-ig-fb-p">Vertical, 1080&nbsp;×&nbsp;1920, cut in CapCut and subtitled in Arabic and English.</p>
                <a href="https://www.instagram.com/reel/DbNR4HenYQQ/" target="_blank" rel="noopener" class="main-link">watch on instagram &#8599;</a>
              </div>
            </div>
          </blockquote>
        </div>

        <div class="ub-ig">
          <p class="ub-ig-k">Pilot two — Digital Skills</p>
          <blockquote
            class="instagram-media"
            data-instgrm-permalink="https://www.instagram.com/reel/DbPvv6KhE3K/?utm_source=ig_embed"
            data-instgrm-version="14"
          >
            <div class="ub-ig-fallback">
              <img src="/syriatek/syriatek-broll-2.webp" alt="A B-roll frame shot for SyriaTek: a street in Syria at dusk, with shopfronts, a food stall and people walking past." loading="lazy" decoding="async" />
              <div class="ub-ig-fb-body">
                <p class="ub-ig-fb-t">SyriaTek — Digital Skills</p>
                <p class="ub-ig-fb-p">Presenter footage cut against street B-roll, same format, same two caption tracks.</p>
                <a href="https://www.instagram.com/reel/DbPvv6KhE3K/" target="_blank" rel="noopener" class="main-link">watch on instagram &#8599;</a>
              </div>
            </div>
          </blockquote>
        </div>

      </div>
      <p class="ub-caption">
        Both published 25 July 2026 to instagram.com/syria.tek. Between them, 3,823
        views and 1,556 unique viewers in fifteen days, with roughly 92% of the reach
        coming from people who did not follow the account.
      </p>

      <div class="ub-block">
        <p class="ub-block-n">Directing</p>
        <h3>An academic year of coverage, on a volunteer crew.</h3>
        <p>
          I was Digital Media Director for the Muslim Students' Association at the
          University of Toronto for a year, running a committee of volunteer
          shooters, assigning coverage of events with the executive team and
          handling post-production in Adobe Creative Cloud. Briefing someone who
          is donating their Saturday teaches you to be specific about the shot
          you actually need, which is the same skill as briefing a supplier who
          is billing you for it.
        </p>
      </div>

      <div class="ub-block">
        <p class="ub-block-n">Shooting</p>
        <h3>And twenty-one clips, filmed in Syria.</h3>
        <p>
          SyriaTek is an Arabic-language technology series I designed and made:
          the bilingual identity, a reusable script and shot-list system, the
          presenter takes and twenty-one B-roll clips filmed on the street in
          Syria, and both pilots cut vertical and subtitled in Arabic and English.
          It reached 1,556 unique viewers in fifteen days, about 92% of them from
          outside the account's own followers.
        </p>
      </div>

      <div class="ub-media ub-media-narrow">
        <img src="/syriatek/syriatek-timeline.webp" alt="The SyriaTek edit timeline in CapCut, showing the B-roll clips against two separate caption tracks." loading="lazy" decoding="async" />
      </div>
      <p class="ub-caption">The edit, with the Arabic and English caption tracks running separately.</p>

      <div class="ub-decision">
        <p class="ub-decision-k">The decision I would bring up in an interview</p>
        <p>
          Writing the second script, I changed the word موصول to متصل, because one
          of them is what people actually say. I cut the term for router and
          described the Wi-Fi device at home or at work. None of that shows in the
          finished video, and all of it is the reason it lands. Donor
          communications runs on the same instinct: the words that reach a reader
          are the ones already in their mouth.
        </p>
      </div>
    </section>

    <div class="ub-divider"></div>

    <!-- ═══════════════════════════════ ABOUT ═══════════════════════════════ -->
    <section id="about" class="ub-section" style="min-height: 80vh;">
      <p class="ub-section-label">About</p>
      <h2 class="ub-h2">Let's make<br>something.</h2>
      <p class="ub-lede">
        I'm in Vancouver, and the hybrid arrangement suits me. I hold a Bachelor
        of Creative Industries and a Diploma in Digital Design &amp; Development,
        both from BCIT, and I work in Arabic and English. Before BCIT I studied
        cognitive science, philosophy and digital humanities at the University of
        Toronto, which is where I picked up the habit of asking how someone reads
        a page before deciding what should be on it.
      </p>
      <p class="ub-lede">
        A stewardship report is read by one person, usually alone, deciding
        whether the thing they paid for actually happened. Every element on the
        page is answerable to that moment. That is the standard I would bring to
        this desk.
      </p>

      <div class="ub-cta-links">
        <a href="mailto:hello@rawanaladdin.com" class="main-link">hello@rawanaladdin.com &#8599;</a>
        <a href="https://www.linkedin.com/in/rawan-aladdin" target="_blank" rel="noopener" class="main-link">linkedin &#8599;</a>
        <a href="/projects.html" class="main-link">full portfolio &#8599;</a>
      </div>

      <p class="ub-footnote">
        Made for UBC Development and Alumni Engagement, August 2026 — requisition JR25772.
      </p>
    </section>

  </main>

  <!-- ═══════════════════════════════ LIGHTBOX ═══════════════════════════════
       Rawan asked for images that open full size. Every thumbnail in the ledger
       is object-fit: cover, so a reviewer was seeing a crop of the very artefact
       the row exists to evidence.

       Progressive enhancement on purpose: the buttons and the overlay are built
       here at runtime rather than shipped in the markup, so with JS blocked the
       page is exactly what it was before — every image still visible, nothing
       broken, no empty dialog in the DOM. The argument never depends on this.
  ═══════════════════════════════════════════════════════════════════════════ -->
  <!-- Instagram's embed script. async, and nothing on the page waits on it:
       if it never arrives, each blockquote keeps the card it already contains. -->
  <script is:inline async src="https://www.instagram.com/embed.js"></script>

  <script is:inline>
    (function () {
      var imgs = [].slice.call(document.querySelectorAll('.ub-thumb img, .ub-media img'));
      if (!imgs.length) return;

      var lb = document.createElement('div');
      lb.className = 'ub-lb';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-modal', 'true');
      lb.setAttribute('aria-label', 'Image viewer');
      lb.setAttribute('data-open', 'false');
      lb.innerHTML =
        '<div class="ub-lb-stage"><img class="ub-lb-img" alt=""></div>' +
        '<div class="ub-lb-foot"><p class="ub-lb-cap"></p><p class="ub-lb-count"></p></div>' +
        '<button type="button" class="ub-lb-close" aria-label="Close image viewer"></button>' +
        '<button type="button" class="ub-lb-prev" aria-label="Previous image"></button>' +
        '<button type="button" class="ub-lb-next" aria-label="Next image"></button>';
      document.body.appendChild(lb);

      var stage = lb.querySelector('.ub-lb-stage');
      var foot = lb.querySelector('.ub-lb-foot');
      var imgEl = lb.querySelector('.ub-lb-img');
      var capEl = lb.querySelector('.ub-lb-cap');
      var countEl = lb.querySelector('.ub-lb-count');
      var closeBtn = lb.querySelector('.ub-lb-close');
      var prevBtn = lb.querySelector('.ub-lb-prev');
      var nextBtn = lb.querySelector('.ub-lb-next');
      var main = document.querySelector('main');

      var current = -1, lastFocus = null, savedBody = 0, savedDoc = 0;

      // Wrap each image in a real <button>, so this is reachable by keyboard and
      // announced as a control rather than being a click handler on a picture.
      var items = imgs.map(function (img, i) {
        var label = img.getAttribute('alt') || 'Image';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ub-zoom';
        btn.setAttribute('aria-label', 'View full size: ' + label);
        img.parentNode.insertBefore(btn, img);
        btn.appendChild(img);
        btn.addEventListener('click', function () { open(i, btn); });
        // data-full points at a larger original where one exists; the page
        // itself only needs the smaller file.
        return {
          src: img.getAttribute('data-full') || img.getAttribute('src'),
          cap: label
        };
      });

      if (items.length < 2) { prevBtn.remove(); nextBtn.remove(); }

      function show(i) {
        current = (i + items.length) % items.length;
        imgEl.src = items[current].src;
        imgEl.alt = items[current].cap;
        capEl.textContent = items[current].cap;
        countEl.textContent = (current + 1) + ' / ' + items.length;
      }

      function open(i, trigger) {
        // Take the trigger explicitly. Relying on document.activeElement is
        // wrong for any click that does not focus its target.
        lastFocus = trigger || document.activeElement;
        // body is the scroll container on this site — html is overflow:hidden
        // and both are height:100%, so document.scrollingElement reports
        // documentElement and window.scrollY stays 0. Measured 2026-08-25.
        // Save both and restore both rather than picking one with ||.
        savedBody = document.body.scrollTop;
        savedDoc = document.documentElement.scrollTop;
        show(i);
        lb.setAttribute('data-open', 'true');
        document.body.classList.add('ub-lb-open');
        if (main && 'inert' in main) main.inert = true;
        // The dialog is visibility:hidden until this style change is recalculated,
        // and a hidden element cannot take focus. Flush layout, then focus, and
        // keep a frame in reserve in case the flush was not enough.
        void lb.offsetHeight;
        closeBtn.focus();
        if (document.activeElement !== closeBtn) {
          requestAnimationFrame(function () { closeBtn.focus(); });
        }
      }

      function close() {
        if (lb.getAttribute('data-open') !== 'true') return;
        lb.setAttribute('data-open', 'false');
        document.body.classList.remove('ub-lb-open');
        if (main && 'inert' in main) main.inert = false;
        // Restore only after the scroll lock is lifted, or it is a no-op.
        document.body.scrollTop = savedBody;
        document.documentElement.scrollTop = savedDoc;
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      closeBtn.addEventListener('click', close);
      prevBtn.addEventListener('click', function () { show(current - 1); });
      nextBtn.addEventListener('click', function () { show(current + 1); });

      // Clicking the surround closes; clicking the image itself does not.
      lb.addEventListener('click', function (e) {
        if (e.target === lb || e.target === stage || e.target === foot) close();
      });

      document.addEventListener('keydown', function (e) {
        if (lb.getAttribute('data-open') !== 'true') return;
        if (e.key === 'Escape') { e.preventDefault(); close(); return; }
        if (items.length > 1 && e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); return; }
        if (items.length > 1 && e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); return; }
        if (e.key === 'Tab') {
          // Keep focus inside the dialog. <main> is inert, but the browser
          // chrome and anything else in <body> is not.
          var f = [closeBtn, prevBtn, nextBtn].filter(function (b) { return b.isConnected; });
          var at = f.indexOf(document.activeElement);
          e.preventDefault();
          f[e.shiftKey ? (at <= 0 ? f.length - 1 : at - 1)
                       : (at === f.length - 1 || at === -1 ? 0 : at + 1)].focus();
        }
      });
    })();
  </script>
</BaseLayout>
